{
  "openapi": "3.1.0",
  "info": {
    "title": "Dashboard Capsule AI REST API",
    "version": "1.0.0",
    "description": "Complete OpenAPI 3.1 specification for Dashboard Capsule AI platform microservices covering Authentication, Ingestion, Capsule Builder, AI Copilot, Analytics, Health Engine, and Enterprise Administration."
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "API Gateway Local Environment"
    },
    {
      "url": "https://api.capsule.ai/v1",
      "description": "Production Cloud Cluster Gateway"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register new organization and administrator account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "fullName": { "type": "string" },
                  "organizationName": { "type": "string" }
                },
                "required": ["email", "password", "fullName"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User and organization created successfully" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user credentials and issue JWT tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful" }
        }
      }
    },
    "/import/upload": {
      "post": {
        "summary": "Upload PBIX payload file and extract AST metadata",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "PBIX archive extracted and AST metadata generated" }
        }
      }
    },
    "/capsules/build": {
      "post": {
        "summary": "Compile dashboard AST into an encrypted .dcaps binary capsule",
        "responses": {
          "200": { "description": "Capsule package built, AES encrypted, and ECDSA signed" }
        }
      }
    },
    "/share/create": {
      "post": {
        "summary": "Generate passcode-protected secure share link for a capsule",
        "responses": {
          "200": { "description": "Share link generated successfully" }
        }
      }
    },
    "/analytics/dashboard": {
      "get": {
        "summary": "Retrieve aggregated dashboard analytics metrics",
        "responses": {
          "200": { "description": "Dashboard analytics returned" }
        }
      }
    },
    "/admin/dashboard": {
      "get": {
        "summary": "Retrieve cluster infrastructure metrics and operational health",
        "responses": {
          "200": { "description": "Cluster metrics returned" }
        }
      }
    }
  }
}
