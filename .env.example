# Environment Mode
NODE_ENV=development
ENVIRONMENT=development

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/dashboard_capsule_db?schema=public"
REDIS_URL="redis://localhost:6379"
MONGO_URL="mongodb://localhost:27017/dcaps_layouts"
VECTOR_DB_URL="http://localhost:6333"

# Security & Authentication
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRY_SECONDS=900
ENCRYPTED_DEK_KMS_ARN="arn:aws:kms:region:account-id:key/your-kms-key-id"

# Services Ports
PORT_LANDING_WEB=3000
PORT_APP_DASHBOARD=3001
PORT_ADMIN_PORTAL=3002
PORT_VIEWER=3003
PORT_API_GATEWAY=8080
PORT_AUTH_SVC=8081
PORT_IMPORT_SVC=8082
PORT_CAPSULE_BUILDER=8083
PORT_ANALYTICS_SVC=8084
PORT_NOTIFICATION_SVC=8085
PORT_AI_CORE=8000
