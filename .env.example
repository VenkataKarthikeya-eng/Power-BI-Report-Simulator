# ==============================================================================
# Power BI Report Simulator — Environment Configuration Template
# Copy this file to .env.local and replace placeholders with your project details.
# ==============================================================================

# Supabase Project Credentials (required for client & SSR authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder

# Optional alias for backward compatibility
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key-placeholder
